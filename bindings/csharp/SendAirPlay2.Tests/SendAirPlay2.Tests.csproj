<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for the C# binding against the real native library, whose
       path is the first argument. No receiver, platform store or test framework. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SendAirPlay2\SendAirPlay2.csproj" />
  </ItemGroup>
</Project>
