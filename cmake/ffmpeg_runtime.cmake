# Resolve DLLs beside the exact FFmpeg import libraries selected by FindFFMPEG.
# The codec prefix may differ from the core vcpkg dependency prefix.
function(sap2_ffmpeg_runtime_dlls output configuration)
  set(runtime_dlls)
  foreach(component avformat avcodec avutil swresample)
    set(selected_library "${FFMPEG_${component}_LIBRARY_${configuration}}")
    if(NOT selected_library AND configuration STREQUAL "DEBUG")
      set(selected_library "${FFMPEG_${component}_LIBRARY_RELEASE}")
    endif()
    if(NOT selected_library OR NOT EXISTS "${selected_library}")
      message(FATAL_ERROR "FFmpeg ${component} library path missing for ${configuration}")
    endif()
    get_filename_component(library_directory "${selected_library}" DIRECTORY)
    get_filename_component(runtime_prefix "${library_directory}" DIRECTORY)
    file(GLOB component_dlls "${runtime_prefix}/bin/${component}*.dll")
    list(LENGTH component_dlls dll_count)
    if(NOT dll_count EQUAL 1)
      message(FATAL_ERROR "Expected one ${component} runtime beside selected ${configuration} library")
    endif()
    list(APPEND runtime_dlls ${component_dlls})
  endforeach()
  set(${output} "${runtime_dlls}" PARENT_SCOPE)
endfunction()
