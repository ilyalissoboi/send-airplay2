cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ffmpeg_runtime.cmake")
get_filename_component(WORK_DIR "${WORK_DIR}" ABSOLUTE)
set(prefix "${WORK_DIR}/selected-codecs")
file(MAKE_DIRECTORY "${prefix}/lib" "${prefix}/bin" "${prefix}/debug/lib" "${prefix}/debug/bin" "${WORK_DIR}/core/bin")
foreach(component avformat avcodec avutil swresample)
  file(WRITE "${prefix}/lib/${component}.lib" "selected release import")
  file(WRITE "${prefix}/debug/lib/${component}.lib" "selected debug import")
  file(WRITE "${prefix}/bin/${component}-test.dll" "selected release runtime")
  file(WRITE "${prefix}/debug/bin/${component}-test.dll" "selected debug runtime")
  file(WRITE "${WORK_DIR}/core/bin/${component}-old.dll" "unrelated old codec")
  set(FFMPEG_${component}_LIBRARY_RELEASE "${prefix}/lib/${component}.lib")
  set(FFMPEG_${component}_LIBRARY_DEBUG "${prefix}/debug/lib/${component}.lib")
endforeach()
if(CASE_MISSING)
  set(FFMPEG_avcodec_LIBRARY_RELEASE "")
  sap2_ffmpeg_runtime_dlls(unused RELEASE)
  message(FATAL_ERROR "Missing selected library unexpectedly accepted")
endif()
set(VCPKG_INSTALLED_DIR "${WORK_DIR}/core")
foreach(configuration RELEASE DEBUG)
  sap2_ffmpeg_runtime_dlls(resolved ${configuration})
  list(LENGTH resolved count)
  if(NOT count EQUAL 4)
    message(FATAL_ERROR "Expected four selected ${configuration} runtimes")
  endif()
  foreach(component avformat avcodec avutil swresample)
    if(configuration STREQUAL "DEBUG")
      set(expected "${prefix}/debug/bin/${component}-test.dll")
    else()
      set(expected "${prefix}/bin/${component}-test.dll")
    endif()
    if(NOT expected IN_LIST resolved)
      message(FATAL_ERROR "Selected ${configuration} runtime missing: ${component}")
    endif()
  endforeach()
endforeach()
set(FFMPEG_avcodec_LIBRARY_DEBUG "")
sap2_ffmpeg_runtime_dlls(resolved DEBUG)
if(NOT "${prefix}/bin/avcodec-test.dll" IN_LIST resolved)
  message(FATAL_ERROR "Release-only import did not retain its matching runtime")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DWORK_DIR=${WORK_DIR}/missing"
  -DCASE_MISSING=ON -P "${CMAKE_CURRENT_LIST_FILE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(result EQUAL 0 OR NOT errors MATCHES "FFmpeg avcodec library path missing for RELEASE")
  message(FATAL_ERROR "Missing selected library did not fail explicitly: ${output}${errors}")
endif()
