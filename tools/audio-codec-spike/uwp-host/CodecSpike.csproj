<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <RootNamespace>SendAirPlay2.CodecSpike</RootNamespace>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <ProbeNativeDir Condition="'$(ProbeNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\build-codec-uwp\tools\audio-codec-spike\Release</ProbeNativeDir>
    <ProbeFfmpegShare Condition="'$(ProbeFfmpegShare)' == ''">$(MSBuildThisFileDirectory)..\..\..\build-codec-tools\installed-uwp\x64-uwp\share\ffmpeg</ProbeFfmpegShare>
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" />
    <None Remove="Package.appxmanifest" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <Content Include="$(ProbeNativeDir)\sap2_codec_probe.dll;$(ProbeNativeDir)\av*.dll;$(ProbeNativeDir)\swresample*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\fixtures\*.m4a;..\fixtures\*.mka">
      <Link>Fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\uwp-host\Assets\*.png">
      <Link>Assets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(ProbeFfmpegShare)\copyright">
      <Link>LICENSE-FFmpeg.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\vcpkg-overlays\LICENSE-vcpkg.txt">
      <Link>LICENSE-vcpkg.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
