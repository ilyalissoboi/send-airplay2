<Page
    x:Class="SendAirPlay2.UwpHost.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="send-airplay2 UWP test host" FontSize="20" />
        <TextBlock Grid.Row="1" x:Name="LibraryStatus" Text="Loading the native library..." />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="ExpectedNameBox" Header="Receiver name to find" Width="200" Text="Living Room" />
            <TextBox x:Name="AddressBox" Header="Receiver address (discover or paste)" Width="240" />
            <TextBox x:Name="ProfileBox" Header="PasswordVault profile" Width="200" Text="living-room-uwp" />
            <TextBox x:Name="BuiltInProfileBox" Header="Built-in store profile" Width="200" Text="living-room-test" />
            <TextBox x:Name="FileLabelBox" Header="Remember picked file as" Width="160" Text="mkv" />
            <TextBox x:Name="StartPositionBox" Header="Start at (seconds)" Width="140" Text="0" />
            <CheckBox x:Name="RemuxBox" Content="HLS remux" IsChecked="True" VerticalAlignment="Bottom" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Content="0. Discover" Click="OnDiscover" />
            <Button Content="1. Probe built-in store" Click="OnProbeBuiltIn" />
            <Button Content="2. Pair into PasswordVault" Click="OnPair" />
            <Button Content="3. Pick media file" Click="OnPickFile" />
            <Button Content="4. Cast (PasswordVault)" Click="OnCastVault" />
            <Button Content="5. Cast (built-in store)" Click="OnCastBuiltIn" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button Content="Pause" Click="OnPause" />
            <Button Content="Play" Click="OnPlay" />
            <Button Content="Seek 60 s" Click="OnSeekForward" />
            <Button Content="Seek 10 s" Click="OnSeekBack" />
            <Button Content="Status" Click="OnStatus" />
            <Button Content="Stop" Click="OnStop" />
        </StackPanel>
        <ScrollViewer Grid.Row="5" x:Name="LogScroller">
            <TextBlock x:Name="LogText" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </ScrollViewer>
    </Grid>
</Page>
