<Project Sdk="Microsoft.NET.Sdk">
  <!-- Packaged UWP test host for the C# binding (D49 step 2b). Built the way
       Screenbox is (modern .NET UWP, Native AOT, MSIX tooling), so it measures
       what Screenbox would meet. Sideloaded locally; not part of CI.

       InternetServerCapability=true selects Package.InternetServer.appxmanifest,
       which adds internetClientServer to Screenbox's capability set. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);stereo-validation/**</DefaultItemExcludes>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <UseUwp>true</UseUwp>
    <Platforms>x64;x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <!-- Function pointers for the native abort trace (NativeAbortTrace.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SendAirPlay2.UwpHost</RootNamespace>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <InternetServerCapability Condition="'$(InternetServerCapability)' == ''">false</InternetServerCapability>
    <!-- Directory holding send_airplay2.dll and its dependencies: the UWP
         (WindowsStore) build for this Platform, which links the app C runtime and
         statically links Botan (docs/uwp-native-build.md): build-uwp (x64),
         build-uwp-x86 or build-uwp-arm64. A desktop shared build (with
         botan-3.dll) also loads, but only where the desktop C runtime is installed. -->
    <Sap2NativeSuffix Condition="'$(Platform)' == 'x86'">-x86</Sap2NativeSuffix>
    <Sap2NativeSuffix Condition="'$(Platform)' == 'ARM64'">-arm64</Sap2NativeSuffix>
    <Sap2NativeDir Condition="'$(Sap2NativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\build-uwp$(Sap2NativeSuffix)\Release</Sap2NativeDir>
    <Sap2StereoAac Condition="'$(Sap2StereoAac)' == ''">false</Sap2StereoAac>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" Condition="'$(InternetServerCapability)' != 'true'" />
    <AppxManifest Include="Package.InternetServer.appxmanifest" Condition="'$(InternetServerCapability)' == 'true'" />
    <None Remove="Package.appxmanifest;Package.InternetServer.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\bindings\csharp\SendAirPlay2\SendAirPlay2.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Sap2StereoAac)' == 'true'">
    <!-- The validated FFmpeg 9 runtime: use the same required list for early
         validation and package content so a missing DLL cannot be globbed away. -->
    <Sap2CodecRuntime Include="$(Sap2NativeDir)\avcodec-63.dll;$(Sap2NativeDir)\avformat-63.dll;$(Sap2NativeDir)\avutil-61.dll;$(Sap2NativeDir)\swresample-7.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- The native library and its OpenSSL DLL, placed in the package root;
         botan-3.dll exists only in desktop shared builds. -->
    <!-- OpenSSL names libcrypto by architecture (libcrypto-3-x64.dll,
         libcrypto-3-arm64.dll, libcrypto-3.dll on x86). -->
    <Content Include="$(Sap2NativeDir)\send_airplay2.dll;$(Sap2NativeDir)\libcrypto-*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(Sap2NativeDir)\botan-3.dll" Condition="Exists('$(Sap2NativeDir)\botan-3.dll')">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="@(Sap2CodecRuntime)" Condition="'$(Sap2StereoAac)' == 'true'">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(Sap2FfmpegShare)\copyright" Condition="'$(Sap2StereoAac)' == 'true'">
      <Link>LICENSE-FFmpeg.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="Sap2CheckNativeDir" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Sap2StereoAac)' == 'true' And !Exists('%(Sap2CodecRuntime.Identity)')" Text="Required codec runtime DLL missing: %(Sap2CodecRuntime.Filename)%(Sap2CodecRuntime.Extension). Choose the validated UWP codec runtime directory." />
    <Error Condition="'$(Sap2StereoAac)' == 'true' And !Exists('$(Sap2FfmpegShare)\copyright')" Text="Choose the matching FFmpeg notice directory; its copyright file is required." />
    <Error Condition="!Exists('$(Sap2NativeDir)\send_airplay2.dll')"
           Text="send_airplay2.dll not found in $(Sap2NativeDir). Build the UWP native library first (docs/uwp-native-build.md) or set Sap2NativeDir." />
  </Target>
</Project>
