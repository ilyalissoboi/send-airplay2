{
  "name": "send-airplay2",
  "version-string": "0.1.0",
  "builtin-baseline": "434307da09bc05b2c86996dccc8b2351fc0d5d37",
  "dependencies": ["openssl", "botan", "boost-beast", "boost-asio"],
  "features": {
    "stereo-aac": {
      "description": "Explicit video delivery with selected audio downmixed to stereo AAC",
      "dependencies": [
        { "name": "ffmpeg", "default-features": false, "features": ["avcodec", "avformat", "swresample"] }
      ]
    },
    "audio-codec-spike": {
      "description": "Optional in-process stereo AAC development probe; no casting integration",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": ["avcodec", "avformat", "swresample"]
        }
      ]
    }
  }
}
